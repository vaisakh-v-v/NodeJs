generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas = ["ticket_system"]
}

model categories {
  category_id Int       @id @default(autoincrement())
  category    String    @db.VarChar(36)
  tickets     tickets[]


  @@schema("ticket_system")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model tickets {
  ticket_id   Int         @id @default(autoincrement())
  title       String      @db.VarChar(255)
  description String
  priority    String?     @db.VarChar(10)
  status      String      @db.VarChar(10)
  category_id Int?
  created_at  DateTime?   @default(now()) @db.Timestamptz(6)
  assignee    String?     @db.VarChar(36)
  customer    String      @db.VarChar(36)
  categories  categories? @relation(fields: [category_id], references: [category_id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("ticket_system")
}